{
  "slug": "care-ops",
  "_comment": "The server, the logo swap and the masking rules name the client, so they live in care-ops.local.json (gitignored). Without it the capture refuses to run.",
  "requiresLocal": true,
  "base": "http://localhost:8443",
  "viewport": [
    1600,
    1000
  ],
  "colorScheme": "light",
  "captionLabel": "Care Ops",
  "init": {
    "css": "html{scrollbar-width:none}"
  },
  "preview": {
    "seconds": 12,
    "posterAt": 4,
    "_comment": "Five beats, hard cuts between them (goto/jump/cut pause the recording); about 12 s of footage.",
    "setup": [
      {
        "do": "goto",
        "url": "/login",
        "wait": 2500
      },
      {
        "do": "click",
        "sel": "button:has-text('Admin & Coordinator')",
        "ms": 1,
        "after": 300
      },
      {
        "do": "click",
        "sel": "button:has-text('Admin Demo')",
        "ms": 1,
        "after": 300
      },
      {
        "do": "click",
        "sel": "button:has-text('Sign In to Portal')",
        "ms": 1,
        "after": 3500
      }
    ],
    "beats": [
      {
        "do": "scroll",
        "by": 420,
        "ms": 1900,
        "settle": 250
      },
      {
        "do": "goto",
        "url": "/roster",
        "wait": 2200
      },
      {
        "do": "jump",
        "to": 160,
        "settle": 600
      },
      {
        "do": "drag",
        "from": ".worker-drag-source",
        "to": "[data-roster-cell='true'] >> nth=2",
        "ms": 1300,
        "after": 900
      },
      {
        "do": "goto",
        "url": "/participants",
        "wait": 1800
      },
      {
        "do": "scroll",
        "by": 300,
        "ms": 1700,
        "settle": 250
      },
      {
        "do": "goto",
        "url": "/dashboard",
        "wait": 1000
      },
      {
        "do": "cut"
      },
      {
        "do": "click",
        "sel": "header button:has-text('Worker'), button:text-is('Worker')",
        "ms": 1,
        "after": 800
      },
      {
        "do": "eval",
        "js": "(()=>{const s=document.createElement(\"style\");s.textContent=\"div[role=status].fixed{display:none!important}\";document.head.appendChild(s)})()",
        "after": 900
      },
      {
        "do": "cut",
        "off": true
      },
      {
        "do": "drag",
        "from": "[role='slider'][aria-label='Slide to clock in'] > div:last-child",
        "by": [
          440,
          0
        ],
        "ms": 1100,
        "after": 800
      },
      {
        "do": "scroll",
        "by": 320,
        "ms": 1400,
        "settle": 250
      }
    ]
  },
